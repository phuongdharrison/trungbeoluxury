@@ -0,0 +1,17 @@
+// Keep session timers in server time, independently of the device wall clock.
+export function createAuthClock({ wallNow = Date.now, monotonicNow = () => performance.now() } = {}) {
+  let serverEpoch;
+  let monotonicEpoch;
+  return {
+    now: () => serverEpoch === undefined ? wallNow() : serverEpoch + Math.max(0, monotonicNow() - monotonicEpoch),
+    synchronize: serverTime => {
+      if (typeof serverTime !== 'number' || !Number.isFinite(serverTime) || serverTime <= 0) return;
+      const previousTime = serverEpoch === undefined ? serverTime : serverEpoch + Math.max(0, monotonicNow() - monotonicEpoch);
+      serverEpoch = Math.max(serverTime, previousTime);
+      monotonicEpoch = monotonicNow();
+    },
+  };
+}
+const clock = createAuthClock();
+export const authNow = clock.now;
+export const synchronizeAuthClock = clock.synchronize;
